# Resend — contact form emails (required for /api/contact)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives new quote notifications
NOTIFY_EMAIL=support@mehrabhq.com

# Verified sender address in Resend (must match a verified domain)
FROM_EMAIL=support@mehrabhq.com

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional — Google Search Console HTML tag verification content value
# NEXT_PUBLIC_GSC_VERIFICATION=
